APP_ID=cli_a000000000000000
APP_SECRET=your_app_secret
ENCRYPT_KEY=your_encrypt_key
VERIFICATION_TOKEN=your_verification_token

BITABLE_APP_TOKEN=your_bitable_app_token
BITABLE_TABLE_ID=your_bitable_table_id
# Optional explicit Bitable table URL (if empty, bot uses app/table tokens to compose URL)
BITABLE_TABLE_URL=

# Drive folder for image uploads (from folder URL: https://xxx.feishu.cn/drive/folder/{token})
DRIVE_FOLDER_TOKEN=your_drive_folder_token

# Optional — Facebook metadata proxy (Cloudflare Worker)
# Deploy cf-worker/ then set the Worker URL and secret here
FB_PROXY_URL=
FB_PROXY_KEY=

# Optional security/reliability settings
# Block private/localhost targets by default to reduce SSRF risk
ALLOW_PRIVATE_TARGETS=false
# Max redirect hops when fetching URL metadata
MAX_REDIRECTS=5
# Dedup cache controls (seconds / max events kept in memory)
EVENT_DEDUP_TTL_SECONDS=21600
EVENT_DEDUP_MAX_SIZE=20000
# Max in-flight background tasks (queued + running)
MAX_IN_FLIGHT_TASKS=100

# The port to run the Flask server on
PORT=5000
